// gg.shakirul.com: a static site served from Workers static assets (no Worker script).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "name": "gg-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "gg.shakirul.com", "custom_domain": true }]
}
